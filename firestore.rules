rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ⚠️ قواعد مفتوحة للتطوير — قبل الإطلاق الفعلي فعّل Firebase Authentication
    // وغيّر الشرط إلى: allow read, write: if request.auth != null;
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
